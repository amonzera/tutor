{
  // Regras do markdownlint usadas na CI e localmente (npx markdownlint-cli2).
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "ignores": ["subjects/**", "node_modules/**", "evals/resultados/**"]
}
